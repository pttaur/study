# ============================================================================
# Скопируйте в .env и задайте реальные значения:  cp .env.example .env
# Файл .env в git не попадает.
# ============================================================================

# --- Хранилище (PostgreSQL) ---
POSTGRES_DB=scagg
POSTGRES_USER=scagg
POSTGRES_PASSWORD=change-me-strong

# --- Backend ---
SC_STORAGE_URL=jdbc:postgresql://db:5432/scagg
SC_STORAGE_USER=scagg
SC_STORAGE_PASSWORD=change-me-strong

# Обязательный ключ шифрования паролей источников (pgcrypto).
# Сгенерировать:  openssl rand -hex 32
SCHEMA_ENCRYPT_KEY=change-me-openssl-rand-hex-32

# Необязательный allowlist хостов целевых БД (через запятую).
# Пусто — без ограничений. Пример: db.internal,*.example.com
SC_CONNECTION_ALLOWED_HOSTS=

# --- Порты на хосте ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
